{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "sites:build": "vinext build",
    "sites:dev": "vinext dev",
    "sites:start": "vinext start",
    "start": "next start",
    "check": "tsc --noEmit",
    "test": "node --test",
    "test:physics": "node --test \"lib/physics/*.test.ts\" \"components/physics-graph/*.test.ts\" \"components/diagrams/*.test.mjs\" \"components/diagrams/*.test.ts\" \"lib/server/task-generator/*.test.ts\"",
    "test:e2e": "playwright test --grep-invert \"@a11y|@visual\"",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "quality:lighthouse": "node scripts/run-lighthouse.mjs",
    "screenshots": "playwright test tests/screenshots",
    "assert:routes": "node scripts/assert-routes-manifest.mjs",
    "smoke": "playwright test --config=playwright.prod.config.ts",
    "audit:tasks": "node lib/server/task-generator/task-bank-audit.ts",
    "audit:art": "node scripts/audit-production-art.mjs"
  },
  "dependencies": {
    "@nanostores/react": "^1.1.0",
    "@phosphor-icons/react": "2.1.10",
