{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.physics-channel/contracts/content-package.schema.json",
  "title": "Physics Channel Content Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "created_at",
    "status",
    "audience",
    "objective",
    "format",
    "copy",
    "visual",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "brief",
        "copy_locked",
        "visual_draft",
        "rendered",
        "qc_passed",
        "human_approved",
        "published"
      ]
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade_range",
        "subject",
        "curriculum_context"
      ],
      "properties": {
        "grade_range": {
          "type": "string"
        },
        "subject": {
          "type": "string",
          "enum": [
            "physics",
            "math",
            "physics_and_math"
          ]
        },
        "curriculum_context": {
          "type": "string"
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "learning_goal",
        "main_misconception",
        "difficulty"
      ],
      "properties": {
        "topic": {
          "type": "string"
        },
        "learning_goal": {
          "type": "string"
        },
        "main_misconception": {
          "type": "string"
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "type"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "official_curriculum",
              "textbook",
              "exam_spec",
              "teacher_note",
              "internal"
            ]
          },
          "url": {
            "type": "string"
          },
          "accessed_at": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "post_type",
        "surface",
        "width",
        "height"
      ],
      "properties": {
        "post_type": {
          "type": "string",
          "enum": [
            "cheat_sheet",
            "mini_guide",
            "meme",
            "problem_breakdown",
            "formula_card",
            "diagram",
            "motivation",
            "carousel"
          ]
        },
        "surface": {
          "type": "string",
          "enum": [
            "telegram_square",
            "telegram_portrait",
            "story_vertical",
            "tiktok_photo"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 512
        },
        "height": {
          "type": "integer",
          "minimum": 512
        },
        "carousel_index": {
          "type": "integer",
          "minimum": 1
        },
        "carousel_total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "title",
        "blocks"
      ],
      "properties": {
        "language": {
          "type": "string",
          "const": "ru"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "body",
                  "formula",
                  "worked_step",
                  "note",
                  "caption",
                  "cta",
                  "label"
                ]
              },
              "text": {
                "type": "string"
              },
              "importance": {
                "type": "string",
                "enum": [
                  "primary",
                  "secondary",
                  "decorative"
                ]
              }
            }
          }
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "style_lane",
        "art_direction",
        "protected_zones"
      ],
      "properties": {
        "route": {
          "type": "string",
          "enum": [
            "deterministic_only",
            "generated_fusion",
            "generated_polish",
            "manual_collage"
          ]
        },
        "style_lane": {
          "type": "string"
        },
        "art_direction": {
          "type": "string"
        },
        "negative_prompt": {
          "type": "string"
        },
        "protected_zones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "x",
              "y",
              "width",
              "height",
              "purpose"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "purpose": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generated_layers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overlay_source": {
          "type": "string"
        },
        "final_png": {
          "type": "string"
        },
        "contact_sheet": {
          "type": "string"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physics_qc",
        "copy_locked",
        "visual_qc",
        "human_review"
      ],
      "properties": {
        "physics_qc": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "copy_locked": {
          "type": "boolean"
        },
        "visual_qc": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "human_review": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}

